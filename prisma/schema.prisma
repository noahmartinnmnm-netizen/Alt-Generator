// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ImageCache {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  altText   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopCredits {
  shop         String   @id
  totalCredits Int      @default(30)
  usedCredits  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ShopSubscription {
  shop                  String   @id
  planId                String   @default("free")
  shopifySubscriptionId String?
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CreditUsage {
  id        Int               @id @default(autoincrement())
  shop      String
  productId String
  imageId   String?
  imageUrl  String?
  usageType TokenUsageType    @default(IMAGE_ALT_TEXT)
  altText   String?
  status    CreditUsageStatus @default(RESERVED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([shop, createdAt])
  @@index([shop, imageId])
  @@index([shop, productId, usageType])
}

enum TokenUsageType {
  IMAGE_ALT_TEXT
  PRODUCT_SEO
}

enum CreditUsageStatus {
  RESERVED
  USED
  REFUNDED
}

model SeoChangeHistory {
  id                       Int             @id @default(autoincrement())
  shop                     String
  productId                String
  imageId                  String?
  imageUrl                 String?
  changeType               SeoChangeType
  previousAltText          String?
  suggestedAltText         String?
  appliedAltText           String?
  previousSeoTitle         String?
  previousSeoDescription   String?
  suggestedSeoTitle        String?
  suggestedSeoDescription  String?
  appliedSeoTitle          String?
  appliedSeoDescription    String?
  status                   SeoChangeStatus @default(SUGGESTED)
  errorMessage             String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  appliedAt                DateTime?
  rolledBackAt             DateTime?

  @@index([shop, createdAt])
  @@index([shop, status])
  @@index([shop, imageId])
  @@index([shop, productId, changeType])
}

enum SeoChangeType {
  IMAGE_ALT_TEXT
  PRODUCT_SEO
}

enum SeoChangeStatus {
  SUGGESTED
  APPLIED
  REJECTED
  FAILED
  ROLLED_BACK
}

model ProductKeywords {
  productId String   @id
  keywords  String
  updatedAt DateTime @updatedAt
}

model ShopSettings {
  shop                 String   @id
  industry             String?
  otherIndustry        String?
  brandName            String?
  brandTagline         String?
  brandValueProp       String?
  productCategories    String?
  searchTerms          String?
  tone                 String?
  onboardingCompleted  Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}
